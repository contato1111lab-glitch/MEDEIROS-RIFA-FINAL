{
  "name": "plataforma-rifas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx dev.ts",
    "build": "vite build && node -e \"require('fs').renameSync('dist/index.html', 'dist/template.html')\" && esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "build:server": "esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "^0.344.0",
    "motion": "^12.38.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^2.12.0",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.27",
